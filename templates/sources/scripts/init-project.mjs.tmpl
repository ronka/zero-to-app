function writeReadme() {
{{#mobile}}
  const content = `# ${config.productName}\n\n${config.description}\n\nThis Expo client targets iOS and Android only. Add backend or API code separately when the product requires it.\n\n## Development\n\n\`\`\`bash\nnpm install\nnpx expo start\n\`\`\`\n\n## Product context\n\nRead [PRODUCT.md](./PRODUCT.md) before changing product behavior or copy. Read [DESIGN.md](./DESIGN.md) before changing visual or layout decisions.\n\n## Versioning and debug menu\n\nThe Settings screen shows \`<app version>-<OTA update>\`. Triple-tap the version row to open native diagnostics. Use \`npm run update\`, \`npm run build:production:ios\`, and \`npm run build:production:android\` so version bumps are committed before EAS commands. Link the repository to an EAS project and run \`npx eas update:configure\` before the first OTA release.\n\n## Included agent skills\n\n- \`add-app-iap\` for RevenueCat purchases\n- \`app-onboarding\` for conversion-focused onboarding\n- \`expo-publish\` for EAS releases\n- \`rtl-layout\` for bidirectional interfaces\n- \`app-version-update\` for release and OTA versioning\n- \`execute-plan\` for implementing Markdown plans task by task\n\nClaude Code discovers skills in \`.claude/skills\`; Codex discovers them in \`.agents/skills\`.\n`;
{{/mobile}}
{{#web}}
  const content = `# ${config.productName}\n\n${config.description}\n\n## Development\n\n\`\`\`bash\nnpm install\nnpm run dev\n\`\`\`\n\nOpen [http://localhost:3000](http://localhost:3000).\n\n## Product context\n\nRead [PRODUCT.md](./PRODUCT.md) before changing product behavior or copy. Read [DESIGN.md](./DESIGN.md) before changing visual or layout decisions.\n\n## Included agent skills\n\n- \`grow-business-payments\` for Grow payment links and webhooks\n- \`execute-plan\` for implementing Markdown plans task by task\n\nClaude Code discovers skills in \`.claude/skills\`; Codex discovers them in \`.agents/skills\`.\n`;
{{/web}}
  writeFileSync(resolve(root, "README.md"), content);
}

function writeMcpConfigs() {
  const servers = {};
  if (config.database === "neon") servers.neon = { type: "http", url: "https://mcp.neon.tech/mcp" };
  if (config.analytics === "posthog") servers.posthog = { type: "http", url: "https://mcp.posthog.com/mcp" };
  if (config.email === "resend") servers.resend = { type: "http", url: "https://mcp.resend.com/mcp" };
  if (Object.keys(servers).length === 0) return;
{{#web}}

{{/web}}
  const claudePath = resolve(root, ".mcp.json");
  const claude = existsSync(claudePath) ? readJson(claudePath) : {};
  claude.mcpServers = { ...(claude.mcpServers ?? {}), ...servers };
  writeJson(claudePath, claude);
{{#web}}

{{/web}}
  const codexPath = resolve(root, ".codex/config.toml");
  mkdirSync(resolve(root, ".codex"), { recursive: true });
  let codex = existsSync(codexPath) ? readFileSync(codexPath, "utf8").trimEnd() : "";
  for (const [name, server] of Object.entries(servers)) {
    if (new RegExp(`^\\[mcp_servers\\.${name}\\]`, "m").test(codex)) continue;
    codex += `${codex ? "\n\n" : ""}[mcp_servers.${name}]\nurl = ${JSON.stringify(server.url)}\n`;
  }
  writeFileSync(codexPath, codex);
}

function readJson(path) { return JSON.parse(readFileSync(path, "utf8")); }
function writeJson(path, value) { writeFileSync(path, `${JSON.stringify(value, null, 2)}\n`); }
{{#web}}
function escapeJsxText(value) { return value.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;").replaceAll("{", "&#123;").replaceAll("}", "&#125;"); }
{{/web}}
function fail(message) { console.error(message); process.exit(1); }
