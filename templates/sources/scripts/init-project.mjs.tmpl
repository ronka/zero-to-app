  const productTs = `export const PRODUCT = ${JSON.stringify({ name: config.productName, description: config.description, locales: config.locales, direction: config.direction, brandColors: config.brandColors }, null, 2)} as const;\n`;
  writeFileSync(resolve(root, "src/constants/product.ts"), productTs);
{{/mobile}}
}

function writeDesignContext() {
  const colors = config.brandColors;
{{#mobile}}
  const content = `# ${config.productName} design\n\n## Brand colors\n\n| Role | Hex | Use |\n| --- | --- | --- |\n| Primary | ${colors.primary} | Brand actions, emphasis, and active states |\n| Accent | ${colors.accent} | Highlights and secondary emphasis |\n| Background | ${colors.background} | Branded screens and launch surfaces |\n| Surface | ${colors.surface} | Cards and elevated components |\n| Text | ${colors.text} | Primary text on the brand background |\n\n## Application\n\n- The implementation source of truth is \`PRODUCT.brandColors\` in \`src/constants/product.ts\`.\n- Use semantic theme colors for standard system surfaces and these brand colors for product identity.\n- Check normal text and interactive controls for WCAG AA contrast after changing any color.\n- Record typography, iconography, spacing, radius, or motion decisions here as the identity develops.\n\nUpdate this file whenever the visual language changes. Agents should read it before making visual or layout decisions.\n`;
{{/mobile}}
{{#web}}
  const content = `# ${config.productName} design\n\n## Brand colors\n\n| Role | Hex | Use |\n| --- | --- | --- |\n| Primary | ${colors.primary} | Brand actions, emphasis, and active states |\n| Accent | ${colors.accent} | Highlights and high-contrast calls to action |\n| Background | ${colors.background} | Main dark canvas |\n| Surface | ${colors.surface} | Cards and elevated dark surfaces |\n| Text | ${colors.text} | Primary text on the brand background |\n\n## Application\n\n- The implementation source of truth is the token block in \`app/globals.css\`.\n- Preserve the landing page's high-contrast section rhythm unless product needs require a different hierarchy.\n- Check normal text and interactive controls for WCAG AA contrast after changing any color.\n- Record typography, imagery, spacing, radius, or motion decisions here as the identity develops.\n\nUpdate this file whenever the visual language changes. Agents should read it before making visual or layout decisions.\n`;
{{/web}}
  writeFileSync(resolve(root, "DESIGN.md"), content);
}

{{#mobile}}
function writeAppShell() {
  const oldRoute = resolve(root, "src/app/explore.tsx");
  const settingsRoute = resolve(root, "src/app/settings.tsx");
  if (existsSync(oldRoute) && !existsSync(settingsRoute)) renameSync(oldRoute, settingsRoute);

  const index = `import { ScrollView, StyleSheet } from 'react-native';\nimport { SafeAreaView } from 'react-native-safe-area-context';\n\nimport { ThemedText } from '@/components/themed-text';\nimport { ThemedView } from '@/components/themed-view';\nimport { BottomTabInset, MaxContentWidth, Spacing } from '@/constants/theme';\nimport { PRODUCT } from '@/constants/product';\nimport { rtlTextAlign } from '@/utils/rtl';\n\nexport default function HomeScreen() {\n  return (\n    <ThemedView style={styles.screen}>\n      <SafeAreaView style={styles.safeArea}>\n        <ScrollView contentContainerStyle={styles.content}>\n          <ThemedText type="smallBold" style={styles.eyebrow}>{PRODUCT.name}</ThemedText>\n          <ThemedText type="title" style={styles.title}>{PRODUCT.description}</ThemedText>\n        </ScrollView>\n      </SafeAreaView>\n    </ThemedView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  screen: { flex: 1 },\n  safeArea: { flex: 1 },\n  content: { width: '100%', maxWidth: MaxContentWidth, alignSelf: 'center', padding: Spacing.four, paddingBottom: BottomTabInset + Spacing.six, gap: Spacing.three },\n  eyebrow: { color: ${JSON.stringify(config.brandColor)}, textTransform: 'uppercase', letterSpacing: 2, textAlign: rtlTextAlign.start },\n  title: { marginTop: Spacing.four, textAlign: rtlTextAlign.start },\n});\n`;
  writeFileSync(resolve(root, "src/app/index.tsx"), index);

  const settings = `import { ScrollView, StyleSheet } from 'react-native';\nimport { SafeAreaView } from 'react-native-safe-area-context';\n\nimport { ThemedText } from '@/components/themed-text';\nimport { ThemedView } from '@/components/themed-view';\nimport { VersionDebugRow } from '@/components/version-debug-row';\nimport { BottomTabInset, MaxContentWidth, Spacing } from '@/constants/theme';\nimport { PRODUCT } from '@/constants/product';\n\nexport default function SettingsScreen() {\n  return (\n    <ThemedView style={styles.screen}>\n      <SafeAreaView style={styles.safeArea}>\n        <ScrollView contentContainerStyle={styles.content}>\n          <ThemedText type="title">{${JSON.stringify(shellLabels.settings)}}</ThemedText>\n          <ThemedView type="backgroundElement" style={styles.card}>\n            <ThemedText type="smallBold">{${JSON.stringify(shellLabels.productLocales)}}</ThemedText>\n            <ThemedText themeColor="textSecondary">{PRODUCT.locales.join(', ')}</ThemedText>\n          </ThemedView>\n          <ThemedView type="backgroundElement" style={styles.card}>\n            <ThemedText type="smallBold">{${JSON.stringify(shellLabels.layoutDirection)}}</ThemedText>\n            <ThemedText themeColor="textSecondary">{PRODUCT.direction}</ThemedText>\n          </ThemedView>\n          <ThemedText type="smallBold" themeColor="textSecondary">{${JSON.stringify(shellLabels.about)}}</ThemedText>\n          <VersionDebugRow />\n        </ScrollView>\n      </SafeAreaView>\n    </ThemedView>\n  );\n}\n\nconst styles = StyleSheet.create({\n  screen: { flex: 1 },\n  safeArea: { flex: 1 },\n  content: { width: '100%', maxWidth: MaxContentWidth, alignSelf: 'center', padding: Spacing.four, paddingBottom: BottomTabInset + Spacing.six, gap: Spacing.three },\n  card: { borderRadius: Spacing.four, padding: Spacing.four, gap: Spacing.one },\n});\n`;
  writeFileSync(settingsRoute, settings);

  writeFileSync(resolve(root, "src/app/_layout.tsx"), `import { DarkTheme, DefaultTheme, LocaleProvider, ThemeProvider } from 'expo-router';\nimport * as SplashScreen from 'expo-splash-screen';\nimport { useColorScheme } from 'react-native';\n\nimport { AnimatedSplashOverlay } from '@/components/animated-icon';\nimport AppTabs from '@/components/app-tabs';\nimport { isRTL } from '@/utils/rtl';\n\nSplashScreen.preventAutoHideAsync();\n\nexport default function TabLayout() {\n  const colorScheme = useColorScheme();\n  return (\n    <LocaleProvider direction={isRTL ? 'rtl' : 'ltr'}>\n      <ThemeProvider value={colorScheme === 'dark' ? DarkTheme : DefaultTheme}>\n        <AnimatedSplashOverlay />\n        <AppTabs />\n      </ThemeProvider>\n    </LocaleProvider>\n  );\n}\n`);

  writeFileSync(resolve(root, "src/components/app-tabs.tsx"), `import { NativeTabs } from 'expo-router/unstable-native-tabs';\nimport { useColorScheme } from 'react-native';\n\nimport { Colors } from '@/constants/theme';\n\nexport default function AppTabs() {\n  const scheme = useColorScheme();\n  const colors = Colors[scheme === 'unspecified' ? 'light' : scheme];\n  return (\n    <NativeTabs backgroundColor={colors.background} indicatorColor={colors.backgroundElement} labelStyle={{ selected: { color: colors.text } }}>\n      <NativeTabs.Trigger name="index">\n        <NativeTabs.Trigger.Label>{${JSON.stringify(shellLabels.home)}}</NativeTabs.Trigger.Label>\n        <NativeTabs.Trigger.Icon src={require('@/assets/images/tabIcons/home.png')} renderingMode="template" />\n      </NativeTabs.Trigger>\n      <NativeTabs.Trigger name="settings">\n        <NativeTabs.Trigger.Label>{${JSON.stringify(shellLabels.settings)}}</NativeTabs.Trigger.Label>\n        <NativeTabs.Trigger.Icon src={require('@/assets/images/tabIcons/explore.png')} renderingMode="template" />\n      </NativeTabs.Trigger>\n    </NativeTabs>\n  );\n}\n`);

{{/mobile}}
{{#web}}
