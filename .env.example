DATABASE_URL=postgresql://user:password@host/database?sslmode=verify-full

BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:3000

# The paymentLinkProcessToken from Grow's verified server notification.
GROW_PAYMENT_LINK_PROCESS_TOKEN=

RESEND_API_KEY=
ACCESS_EMAIL_FROM=Zero to SaaS <access@example.com>

# Optional; falls back to BETTER_AUTH_SECRET.
MAGIC_LINK_RATE_LIMIT_SECRET=

# Only rendered after server-side entitlement authorization.
ACCESS_WEB_REPO_URL=https://github.com/hightechguide/starter-web
ACCESS_MOBILE_REPO_URL=https://github.com/hightechguide/starter-mobile

# One GitHub App provides buyer OAuth identity and installation-level repo access.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Paste the PEM on one line with literal \n separators when multiline values are unavailable.
GITHUB_APP_PRIVATE_KEY=
